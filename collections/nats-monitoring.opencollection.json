    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Account information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8222/accountz",
            "params": [
              {
                "name": "acc",
                "value": "",
                "type": "query"
              }
