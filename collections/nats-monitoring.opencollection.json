    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8222/healthz",
            "params": [
              {
                "name": "js-enabled-only",
